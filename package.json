{
  "name": "schummar-table",
  "version": "0.0.0",
  "description": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schummar/schummar-table.git"
  },
  "author": {
    "name": "Marco Schumacher",
    "email": "marco@schumacher.dev"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./csvExporter": {
      "import": "./dist/csvExporter.js",
      "require": "./dist/csvExporter.cjs"
    },
    "./excelExporter": {
      "import": "./dist/excelExporter.js",
      "require": "./dist/excelExporter.cjs"
    },
    "./mui4Theme": {
      "import": "./dist/mui4Theme.js",
      "require": "./dist/mui4Theme.cjs"
    },
    "./mui5Theme": {
      "import": "./dist/mui5Theme.js",
      "require": "./dist/mui5Theme.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "start": "pnpm -C docs start",
    "build": "vp pack",
    "lint": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:watch": "vp test watch",
    "docs:build": "pnpm -C docs build"
  },
  "peerDependencies": {
    "@material-ui/core": ">=4.0.0",
    "@mui/material": ">=5.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "xlsx": ">=0.18.5"
  },
  "peerDependenciesMeta": {
    "@emotion/styled": {
      "optional": true
    },
    "@material-ui/core": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "dependencies": {
    "@emotion/react": ">=11.11.1",
    "date-fns": "^4.4.0",
    "immer": ">=9.0.21",
    "nanoid": ">=4.0.2",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@emotion/styled": "11.14.1",
    "@material-ui/core": "4.12.4",
    "@mui/material": "5.14.18",
    "@nx/js": "^23.2.1",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "@vitest/browser-playwright": "5.0.1",
    "nx": "^23.2.1",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "schummar-state": "0.2.1-experimental-13",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.6.0",
    "vite-plus": "catalog:",
    "vitest": "5.0.1",
    "vitest-browser-react": "^2.3.0",
    "xlsx": "0.18.5"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "inlinedDependencies": {
    "schummar-state": "0.2.1-experimental-13"
  }
}
