{
  "name": "schummar-table",
  "version": "0.0.0",
  "description": "A fast, fully typed React table with sorting, filtering, selection, trees, virtualization, persistence and exports.",
  "keywords": [
    "react",
    "table",
    "data-table",
    "datagrid",
    "grid",
    "typescript",
    "virtualization",
    "filter",
    "sort",
    "tree",
    "emotion",
    "mui"
  ],
  "homepage": "https://github.com/schummar/schummar-table#readme",
  "bugs": {
    "url": "https://github.com/schummar/schummar-table/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schummar/schummar-table.git"
  },
  "author": {
    "name": "Marco Schumacher",
    "email": "marco@schumacher.dev"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skills"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./csvExporter": {
      "import": "./dist/csvExporter.js",
      "require": "./dist/csvExporter.cjs"
    },
    "./excelExporter": {
      "import": "./dist/excelExporter.js",
      "require": "./dist/excelExporter.cjs"
    },
    "./mui4Theme": {
      "import": "./dist/mui4Theme.js",
      "require": "./dist/mui4Theme.cjs"
    },
    "./mui5Theme": {
      "import": "./dist/mui5Theme.js",
      "require": "./dist/mui5Theme.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "start": "pnpm -C docs start",
    "build": "vp pack",
    "lint": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:watch": "vp test watch",
    "bench": "vp test bench --run --reporter=verbose",
    "docs:build": "pnpm -C docs build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.1",
    "@material-ui/core": ">=4.0.0",
    "@mui/material": ">=5.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "xlsx": ">=0.18.5"
  },
  "peerDependenciesMeta": {
    "@material-ui/core": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/serialize": "^1.3.3",
    "@emotion/utils": "^1.4.2",
    "@tanstack/react-virtual": "^3.14.13",
    "date-fns": "^4.4.0",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@material-ui/core": "4.12.4",
    "@mui/material": "5.14.18",
    "@nx/js": "^23.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.1",
    "nx": "^23.2.1",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2",
    "unplugin-unused": "^0.6.0",
    "vite-plus": "catalog:",
    "vitest": "5.0.1",
    "vitest-browser-react": "^2.3.0",
    "xlsx": "0.18.5"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "warn"
    }
  }
}
